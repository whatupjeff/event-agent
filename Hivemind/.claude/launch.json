{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "cd backend && exec ~/.venvs/event-agent/bin/uvicorn app.main:app --port 8000"],
      "port": 8000
    },
    {
      "name": "ui",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "cd frontend && exec npx vite --port 5173 --strictPort"],
      "port": 5173
    }
  ]
}
